<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Picart.Pages.ProductGroupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:Picart.Models"
    xmlns:vm="clr-namespace:Picart.ViewModels"
    Title="{Binding GroupName}"
    x:DataType="vm:ProductGroupViewModel">
    <ScrollView>
        <ListView ItemsSource="{Binding Products}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Product">
                    <ViewCell>
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        x:Name="DeleteProductSwipeItem"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductGroupViewModel}}, Path=DeleteProductCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource DeleteSwipeItem}"
                                        Text="delete" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Grid Padding="10" ColumnDefinitions="Auto,Auto">
                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding Checked}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </SwipeView>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </ScrollView>
</ContentPage>